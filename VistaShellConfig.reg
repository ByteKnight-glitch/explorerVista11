Windows Registry Editor Version 5.00

; ==============================================================================
; Windows Vista Shell Configuration for explorer7 on Windows 11 24H2 (Build 26100)
; ==============================================================================

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
; Visual Style & Custom Start Orb
"Theme"="aero"
"OrbDirectory"="vista"

; Vista Taskbar Behavior (Bypasses Win11 24H2 Taskband Pinning issues)
; 0 = Disables Superbar taskbar pinning, replicating Vista's classic running tasks
"UseTaskbarPinning"=dword:00000000

; Taskbar Lock State (1 = Unlocked so Toolbars like Quick Launch / Desktop can be added & moved)
"TaskbarSizeMove"=dword:00000001

; Taskbar Button Appearance (2 = Never combine buttons, displays window titles like Vista)
"TaskbarGlomLevel"=dword:00000002

; Taskbar Size (1 = Classic small icons / 30px height matching Vista)
"TaskbarSmallIcons"=dword:00000001

; Immersive / UWP Integration (EnableImmersive=1 enables Snap Windows via twinui.pcshell.dll)
"EnableImmersive"=dword:00000001
"StoreAppsOnTaskbar"=dword:00000000
"StoreAppsInStart"=dword:00000001

; Snap Windows (Aero Snap)
"SnapAssist"=dword:00000001
"JointResize"=dword:00000001
"SnapFill"=dword:00000001
"EnableSnapAssistFlyout"=dword:00000001

; Start Menu & Search (Vista/7 population, MFU tracking, and search)
"Start_TrackProgs"=dword:00000001
"Start_TrackDocs"=dword:00000001
"Start_MinMFU"=dword:0000000a
"Start_LargeMFUIcons"=dword:00000001
"Start_SearchPrograms"=dword:00000001
"Start_SearchFiles"=dword:00000002
"Start_ShowUser"=dword:00000001
"Start_ShowMyDocs"=dword:00000001
"Start_ShowMyPics"=dword:00000001
"Start_ShowMyMusic"=dword:00000001
"Start_ShowMyGames"=dword:00000001
"Start_ShowMyComputer"=dword:00000001
"Start_ShowNetConn"=dword:00000001
"Start_ShowControlPanel"=dword:00000001
"Start_ShowSetProgramAccessAndDefaults"=dword:00000001
"Start_ShowHelp"=dword:00000001
"Start_ShowRun"=dword:00000001
"Start_ShowSearch"=dword:00000001

; Aero Glass & Colorization (Aero mode enabled, composition active)
"DisableComposition"=dword:00000000
"ClassicTheme"=dword:00000000
"ColorizationOptions"=dword:00000001
"AcrylicColorization"=dword:00000000

; Mark first run check as acknowledged
"FirstRunVersionCheck"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer]
; Auto-hide inactive notification icons on the taskbar (1 = Enabled, Vista/7 style)
"EnableAutoTray"=dword:00000001
